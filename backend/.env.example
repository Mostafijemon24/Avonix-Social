DATABASE_URL="file:./dev.db"

CREDITS_PER_DOLLAR=100
MARGIN_MULTIPLIER=1.3

OPENROUTER_API_KEY=
APP_URL=http://localhost:3000
PORT=4000

STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
PAYPAL_WEBHOOK_ID=

# JWT secret for admin sessions (min 32 chars) — required
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32chars

# Super Admins via VPS only: npm run admin:create

# Notification channels (optional — demo mode logs without these)
SMTP_URL=
SMTP_FROM=noreply@avonixsocial.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TELEGRAM_BOT_TOKEN=

# Reminder jobs
POST_REMINDER_HOURS=24
REVIEW_REMINDER_HOURS=12
REMINDER_INTERVAL_MS=3600000
