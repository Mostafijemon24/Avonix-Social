DATABASE_URL="file:./dev.db"
NODE_ENV=production

CREDITS_PER_DOLLAR=100
MARGIN_MULTIPLIER=1.3

OPENROUTER_API_KEY=
# ChatGPT image model (OpenRouter Images API) — PAID; only used when image source = AI
IMAGE_MODEL=openai/gpt-image-1
# IMAGE_QUALITY=high
# DEFAULT_AI_MODEL=google/gemini-2.5-flash
# KEYWORD_MODEL=openai/gpt-4o-mini
# ─── Website intelligence crawler (bounded, SSRF-safe) ───
# SITE_MAX_PAGES=150              # pages the keyword analyzer will crawl
# SITE_MAX_SITEMAP_URLS=2000      # max URLs harvested from sitemaps
# SITE_MAX_CHILD_SITEMAPS=50      # nested sitemap files followed
# SITE_FETCH_CONCURRENCY=8        # parallel fetches (keyword analyzer)
# SITE_FETCH_TIMEOUT_MS=10000     # per-request timeout
# SITE_MAX_REDIRECTS=5            # redirect hops (each re-validated for SSRF)
# SITE_MAX_RESPONSE_BYTES=3000000 # body-size cap per page
# SITE_CACHE_TTL_MS=900000        # reuse a recent analysis for 15 min
# SITE_SSRF_GUARD_DISABLED=0      # NEVER set to 1 in production
# ─── Content Studio analysis vs generation ───
# STUDIO_MAX_ANALYZE_PAGES=150    # pages analysed per site (was hard-capped at 15)
# STUDIO_MAX_GENERATE_PAGES=15    # pages × platforms fan-out for post generation (cost control)
# STUDIO_ANALYZE_CONCURRENCY=8    # parallel page analysis
# STUDIO_ANALYSIS_CACHE_TTL_MS=900000
# STUDIO_GENERATE_LOCK_TTL_MS=120000  # duplicate-generation guard window (double-click protection)

# ─── Studio images (quality-first) ───
# quality = AI picks best paid model (gpt-image-1). free = $0 Pollinations only.
STUDIO_IMAGE_DEFAULT=quality
STUDIO_FREE_IMAGES_ONLY=0
IMAGE_MODEL=openai/gpt-image-1
IMAGE_QUALITY=high
# Pollinations / Pexels / Unsplash only used as fallback or when user picks Free
POLLINATIONS_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

APP_URL=https://social.avonixai.com
# Public API origin used in OAuth redirect_uri (same host when /api is proxied)
API_PUBLIC_URL=https://social.avonixai.com
PORT=4000

STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
PAYPAL_WEBHOOK_ID=
# Never set true on production — blocks fake instant top-ups
# ALLOW_DEMO_TOPUP=false

ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32chars
USER_JWT_SECRET=change-me-to-a-long-random-user-session-secret-32chars
CONNECTIONS_STATE_SECRET=

# ─── Social connections (OAuth) ───
# Meta Developer App → add Valid OAuth Redirect URIs from GET /api/connections/setup
META_APP_ID=
META_APP_SECRET=
# Optional OAuth scopes (comma-separated). Defaults omit pages_manage_posts until Meta use case is enabled.
# META_FB_OAUTH_SCOPES=pages_show_list,pages_read_engagement,business_management
# META_IG_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,business_management
# After Meta "Manage everything on your Page" + Instagram use cases are Ready for testing:
# META_FB_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,business_management
# META_IG_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,business_management

# Google Cloud OAuth client + Business Profile API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn Developer App — use ONE product family per app (LinkedIn rule):
# A) Sign In with LinkedIn using OpenID Connect
#    optional Share on LinkedIn → LINKEDIN_SHARE_ON_LINKEDIN=1
# B) Community Management API ONLY (Company Pages) — cannot mix with A on the same app
#    LINKEDIN_COMMUNITY_MANAGEMENT=1
# Redirect URL:
#   https://social.avonixai.com/api/connections/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_COMMUNITY_MANAGEMENT=1
# LINKEDIN_OAUTH_SCOPES=r_organization_social w_organization_social rw_organization_admin
# LINKEDIN_SHARE_ON_LINKEDIN=1
# LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social

# ─── X (Twitter) — OAuth 2.0 with PKCE ───
# X Developer Portal → Project/App → Keys. Confidential client (type = Web App).
# Scopes: tweet.read tweet.write users.read offline.access media.write
#   (media.write is required to attach images to tweets)
# Redirect URL:
#   https://social.avonixai.com/api/connections/oauth/x/callback
#   (local: http://localhost:4000/api/connections/oauth/x/callback)
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write

# ─── Pinterest — OAuth 2.0 (API v5) ───
# Pinterest Developer Portal → App → App ID / App secret.
# Scopes: boards:read pins:read pins:write user_accounts:read
# Redirect URL:
#   https://social.avonixai.com/api/connections/oauth/pinterest/callback
#   (local: http://localhost:4000/api/connections/oauth/pinterest/callback)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# PINTEREST_OAUTH_SCOPES=boards:read pins:read pins:write user_accounts:read

# ─── Hostinger Email (SMTP) ───
# Use the mailbox password from hPanel → Emails (not account password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@avonixai.com
SMTP_PASS=your-email-password
SMTP_FROM="Avonix Social <noreply@avonixai.com>"

# Default phone region when user enters local format (01… or 1[3-9]…)
SMS_DEFAULT_REGION=BD

# ─── SMS: for Bangladesh use BulkSMSBD or SMS.NET.BD (US SignalWire often fails to BD) ───
SMS_PROVIDER=bulksmsbd

# BulkSMSBD (recommended for +880) — https://bulksmsbd.net
BULKSMSBD_API_KEY=
# Approved Sender ID from dashboard (NOT the API key). Register at Sender ID Management.
BULKSMSBD_SENDER_ID=
# OTP SMS must be: "Your {Brand} OTP is XXXX"
BULKSMSBD_OTP_BRAND=Avonix Social
# BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi

# SMS.NET.BD (optional) — https://sms.net.bd
SMSNETBD_API_KEY=

# SignalWire (US / international — often does NOT deliver to BD SIMs)
# SMS_PROVIDER=signalwire
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SIGNALWIRE_API_TOKEN=PTxxxxxxxx
SIGNALWIRE_SMS_FROM=+1XXXXXXXXXX

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# WhatsApp backup for phone OTP when SMS fails (Twilio WhatsApp)
TWILIO_WHATSAPP_FROM=
TELEGRAM_BOT_TOKEN=

POST_REMINDER_HOURS=24
REVIEW_REMINDER_HOURS=12
REMINDER_INTERVAL_MS=3600000

# ─── 30-Day Sheet Automation (Google Sheets, server-side only) ───
# Create a Google Cloud service account, enable the Google Sheets API, download
# the JSON key, then SHARE the target sheet with the service-account email as Viewer.
# Option A — inline creds (recommended on a VPS; keep the \n escapes intact):
GOOGLE_SA_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Option B — path to the downloaded JSON key file (overrides A if set):
# GOOGLE_SA_KEY_FILE=/var/www/avonix-social/backend/secrets/sheets-sa.json
# Default spreadsheet ID (from the sheet URL .../d/<THIS_ID>/edit) + A1 range.
# Recommended columns: Row_ID | Date | Topic / Title | Generate_Image (Yes/No) | Schedule_Time
# Row_ID is an immutable per-row key so editing a topic updates the same post
# instead of creating a duplicate (highly recommended).
CONTENT_SHEET_ID=
CONTENT_SHEET_RANGE=Sheet1!A:E
# Safety cap on how many rows one sync will process (prevents runaway AI cost):
SHEET_MAX_ROWS=60
