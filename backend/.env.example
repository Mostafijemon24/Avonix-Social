DATABASE_URL="file:./dev.db"
NODE_ENV=production

CREDITS_PER_DOLLAR=100
MARGIN_MULTIPLIER=1.3

OPENROUTER_API_KEY=
APP_URL=https://social.avonixai.com
PORT=4000

STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
PAYPAL_WEBHOOK_ID=

# JWT secret for admin sessions (min 32 chars) — required
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32chars

# ─── Hostinger Email (SMTP) ───
# Option A: separate fields (recommended for Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@avonixai.com
SMTP_PASS=your-email-password
SMTP_FROM="Avonix Social <noreply@avonixai.com>"

# Option B: single URL (alternative)
# SMTP_URL=smtps://noreply@avonixai.com:password@smtp.hostinger.com:465

# ─── Twilio SMS (US phone verification) ───
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SMS_FROM=+1XXXXXXXXXX

# Optional WhatsApp (same Twilio account)
TWILIO_WHATSAPP_FROM=
TELEGRAM_BOT_TOKEN=

# Reminder jobs
POST_REMINDER_HOURS=24
REVIEW_REMINDER_HOURS=12
REMINDER_INTERVAL_MS=3600000
