generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Package {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  monthlyCredits Int
  priceUsd       Float          @default(0)
  renewalDays    Int            @default(30)
  isActive       Boolean        @default(true)
  users          User[]
  subscriptions  Subscription[]
  paymentLogs    PaymentLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  name                  String?
  phone                 String?
  company               String?
  passwordHash          String?
  packageId             String
  package               Package             @relation(fields: [packageId], references: [id])
  remainingCredits      Int                 @default(0)
  unlimitedCredits      Boolean             @default(false)
  notes                 String?
  source                String?             @default("signup")

  // Verification (required before plan join)
  emailVerified         Boolean             @default(false)
  phoneVerified         Boolean             @default(false)
  cardOnFile            Boolean             @default(false)
  cardLast4             String?
  cardBrand             String?
  stripePaymentMethodId String?

  // Wallet (USD balance for top-up / auto-debit)
  walletBalanceUsd      Float               @default(0)

  // Subscription lifecycle: none | trial | active | frozen
  accountStatus         String              @default("pending_verification")

  // Multi-channel notification prefs
  notifyEmail           Boolean             @default(true)
  notifyWhatsapp        Boolean             @default(true)
  notifyTelegram        Boolean             @default(true)
  whatsappNumber        String?
  telegramChatId        String?

  // Activity for missed-post / missed-reply reminders
  lastSocialPostAt      DateTime?
  lastGbpPostAt         DateTime?
  lastReviewReplyAt     DateTime?
  pendingReviewCount    Int                 @default(0)

  stripeCustomerId      String?
  paypalCustomerId      String?
  usageLogs             UsageLog[]
  subscriptions         Subscription[]
  paymentLogs           PaymentLog[]
  walletTxns            WalletTransaction[]
  notifications         NotificationLog[]
  verificationCodes     VerificationCode[]
  connectedAccounts     ConnectedAccount[]
  clientWorkspaces      ClientWorkspace[]
  activeWorkspaceId     String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

/** Agency multi-client workspace (one user → many clients) */
model ClientWorkspace {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  websiteUrl         String?
  domain             String?
  notes              String?
  // Cached sitemap / keyword context for this client
  primaryKeyword     String?
  secondaryKeywords  String? // JSON array
  location           String?
  address            String?
  sitemapUrl         String?
  sitemapUrlCount    Int                @default(0)
  sitemapParsedAt    DateTime?
  connectedAccounts  ConnectedAccount[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
}

/** Social / GBP connected profiles (OAuth or manual URL link) */
model ConnectedAccount {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      ClientWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       String // facebook | instagram | google_business | linkedin | x | pinterest
  authType       String           @default("oauth") // oauth | manual
  status         String           @default("connected") // connected | linked | expired | error
  accountId      String?
  accountName    String?
  accountUrl     String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  metadata       String? // JSON: pageId, igUserId, locationName, etc.
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, provider])
  @@index([workspaceId, provider])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  phone     String?
  channel   String // email | sms
  code      String
  purpose   String // register | login | topup | password_reset | admin_password_reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([phone, purpose])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // topup | debit_usage | debit_plan | refund | freeze
  amountUsd   Float
  balanceAfter Float
  gateway     String?
  status      String   @default("completed")
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String // email | whatsapp | telegram
  type      String // missed_post | missed_review | low_balance | frozen | verify
  title     String
  body      String
  status    String   @default("sent") // sent | failed | demo
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model UsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           String
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  apiCostUsd       Float    @default(0)
  creditsDeducted  Int
  metadata         String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId        String
  package          Package   @relation(fields: [packageId], references: [id])
  status           String    @default("active") // active | frozen | cancelled
  gateway          String
  gatewaySubId     String?
  currentPeriodEnd DateTime?
  frozenAt         DateTime?
  freezeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("super_admin")
  totpSecret   String
  totpEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaymentLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId        String
  package          Package  @relation(fields: [packageId], references: [id])
  amountUsd        Float
  gateway          String
  gatewayPaymentId String?
  status           String   @default("completed")
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model ApiConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  source    String   @default("contact")
  status    String   @default("new")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, createdAt])
  @@index([status])
}

/**
 * Persisted website page inventory + user selection (Sitemap Selection step).
 * One row per discovered page, scoped to user + workspace + website origin.
 * `workspaceId` is coalesced to "" (never null) so the uniqueness constraint
 * reliably prevents duplicate page records even for the default workspace.
 */
model WebsitePage {
  id                String    @id @default(cuid())
  userId            String
  workspaceId       String    @default("")
  websiteOrigin     String // https://example.com
  url               String // normalized page URL
  title             String    @default("")
  pageType          String    @default("")
  writingIntent     String    @default("")
  areaCoverage      String    @default("")
  primaryKeyword    String    @default("")
  secondaryKeywords String    @default("[]") // JSON array
  reachable         Boolean   @default(true)
  status            String    @default("analyzed") // analyzed | failed | excluded
  selected          Boolean   @default(false)
  selectedAt        DateTime?
  analyzedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, workspaceId, websiteOrigin, url])
  @@index([userId, workspaceId, websiteOrigin])
  @@index([userId, workspaceId, websiteOrigin, selected])
}

/** Detected services per website with cross-page evidence + user selection. */
model WebsiteService {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String    @default("")
  websiteOrigin String
  name          String
  pages         String    @default("[]") // JSON array of evidence URLs
  pageCount     Int       @default(0)
  selected      Boolean   @default(true)
  selectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, workspaceId, websiteOrigin, name])
  @@index([userId, workspaceId, websiteOrigin])
}

/** Content Studio auto-poster records (draft / scheduled / published+locked / archived) */
model StudioPost {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String?
  fingerprint    String // url|platform|primaryKeyword — prevents duplicate publish
  websiteOrigin  String? // e.g. https://example.com — groups posts per website
  sourceUrl      String
  platform       String // Facebook | Instagram | LinkedIn | GMB | X | Pinterest
  tone           String
  location       String
  primaryKeyword String
  secondaryKeyword String
  generalKeywords String // JSON array of 4
  heading        String
  content        String
  contentHtml    String?
  imageUrl       String?
  imageSourceUrl String? // original image before a title overlay (non-destructive edit)
  overlayConfig  String? // JSON of the title-overlay settings so it can be reopened/adjusted
  imageStatus    String? // null = none/legacy | pending | ready | failed (Batch 4 deferred images)
  status         String    @default("draft") // draft | scheduled | publishing | published | canceled
  locked         Boolean   @default(false)
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  canceledAt     DateTime? // when a scheduled post was canceled/deleted (audit)
  rewriteOfId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, fingerprint])
  @@index([userId, workspaceId, status])
  @@index([userId, workspaceId, archived])
  @@index([userId, websiteOrigin, archived])
  @@index([status, scheduledAt])
}

/**
 * Batch 5 — durable background job queue. The database IS the queue (no extra
 * infra): every accepted job is committed here before being reported queued,
 * survives process/worker restarts, is claimed atomically (so two workers can
 * never run the same job), retries with bounded exponential backoff, and is
 * idempotent via a unique dedupeKey (one job per logical unit of work).
 */
model BackgroundJob {
  id             String    @id @default(cuid())
  type           String // e.g. "image.generate"
  status         String    @default("queued") // queued | running | succeeded | failed | canceled
  dedupeKey      String    @unique // idempotent enqueue — one job per logical unit
  payload        String    @default("{}") // JSON input for the handler
  result         String? // JSON of the handler result (on success)
  lastError      String? // last failure message (never contains secrets/tokens)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  priority       Int       @default(0) // higher runs first

  // Tenancy / isolation — jobs are always scoped and never cross tenants.
  userId         String?
  workspaceId    String?
  websiteOrigin  String?
  resourceId     String? // e.g. the StudioPost id this job acts on

  // Scheduling + leasing for safe concurrent claim and restart recovery.
  runAfter       DateTime  @default(now()) // earliest time this job may run (backoff)
  lockedBy       String? // worker id that currently holds the lease
  leaseExpiresAt DateTime? // a running job past this is considered crashed → requeued
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([userId, workspaceId, status])
  @@index([resourceId])
}
